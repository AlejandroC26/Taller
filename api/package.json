{
  "name": "taller-api",
  "version": "1.0.0",
  "description": "API del Taller Pulgas Locas S.A.S.: Next.js con TypeORM y PostgreSQL, sedes, órdenes de servicio con garantía y servidor MCP para agentes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "tipos": "tsc --noEmit",
    "migracion:generar": "tsx node_modules/typeorm/cli.js migration:generate -d src/base-datos/fuente.ts",
    "migracion:correr": "tsx node_modules/typeorm/cli.js migration:run -d src/base-datos/fuente.ts",
    "migracion:revertir": "tsx node_modules/typeorm/cli.js migration:revert -d src/base-datos/fuente.ts",
    "semilla": "tsx src/base-datos/semilla.ts",
    "pruebas": "vitest run",
    "pruebas:vigilar": "vitest",
    "flujo": "node pruebas/flujo.mjs",
    "mcp": "node pruebas/probar-mcp.mjs",
    "simular": "node pruebas/simular.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "jose": "^6.2.13",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
