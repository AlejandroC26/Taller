# Variables del taller en Docker (docker-compose.yml). Copie este archivo como .env y complete.
# .env no se sube al repositorio. En desarrollo, sin Docker, las variables viven en SENA-IA/.env.

# Base de datos propia del taller (la crea el contenedor db la primera vez).
DB_USUARIO=taller
DB_CLAVE=

# Secreto para firmar los tokens: largo y al azar.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TALLER_JWT_SECRETO=

# Primer administrador; lo crea la semilla. Clave de 10 caracteres o más.
TALLER_ADMIN_USUARIO=admin
TALLER_ADMIN_CLAVE=

# Token fijo del MCP para los otros grupos (usuario agente-compartido). Vacío = la semilla crea uno.
TALLER_MCP_TOKEN_FIJO=

# Modelo local (Ollama del equipo). Por defecto http://host.docker.internal:11434/v1
LOCAL_MODELO=llama3.2
LOCAL_TIEMPO_MS=8000

# Otros grupos. Sin URL, el concesionario es el simulado y facturación queda desactivada.
MCP_CONCESIONARIO_URL=
MCP_CONCESIONARIO_TOKEN=
MCP_FACTURACION_URL=
MCP_FACTURACION_TOKEN=
